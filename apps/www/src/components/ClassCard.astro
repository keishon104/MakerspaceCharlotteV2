---
import type { CollectionEntry } from "astro:content";

interface Props {
  item: CollectionEntry<"classes">;
}

const { item } = Astro.props;
---

<article class="card class-card" data-reveal>
  <div class="card-media class-card-media">
    <img src={item.data.image.src} alt={item.data.image.alt} loading="lazy" />
  </div>
  <div class="card-body">
    <div class="class-meta">
      <span>{item.data.category}</span>
      <span>{item.data.level}</span>
    </div>
    <h3>{item.data.title}</h3>
    <p>{item.data.summary}</p>
    <p class="class-schedule">{item.data.schedule} / {item.data.pricing}</p>
    <p class="class-card-actions">
      <a class="text-link" href={`/classes/${item.id}/`}>Browse dates</a>
    </p>
  </div>
</article>
