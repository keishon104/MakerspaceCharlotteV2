---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Membership | MakerSpace Charlotte">
  <section class="page-hero">
    <div class="section-inner">
      <p class="eyebrow">Membership</p>
      <h1>Access the tools, space, and community to keep making.</h1>
      <p>
        Membership is currently listed at $50/month and includes 24/7 access after
        onboarding, plus discounted classes and family access.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="section-inner split">
      <div>
        <h2>What membership should make clear</h2>
        <p>
          This page should remove uncertainty before someone comes to a tour or fills
          out an application.
        </p>
        <ul class="check-list">
          <li>Current price and what is included</li>
          <li>How family access works</li>
          <li>How 24/7 access starts after onboarding</li>
          <li>Which shops require safety classes</li>
          <li>How studio spots and storage work</li>
          <li>Member expectations and community norms</li>
        </ul>
      </div>
      <div class="data-panel">
        <h2>Primary Next Step</h2>
        <p>Tour the facility on Wednesday at 7pm, then pick up or complete the membership application.</p>
        <p>
          <a
            class="button button-primary"
            href="https://www.eventbrite.com/e/makerspace-charlotte-open-house-tickets-1128405373849?aff=ebdsoporgprofile"
          >
            Book a Tour
          </a>
        </p>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="section-inner data-grid">
      <article class="data-panel">
        <h2>Included</h2>
        <ul class="plain-list">
          <li>Shared shop access after orientation</li>
          <li>24/7 building access for members</li>
          <li>Discounted classes</li>
          <li>Community knowledge and project help</li>
        </ul>
      </article>
      <article class="data-panel">
        <h2>Needs Confirmation</h2>
        <ul class="plain-list">
          <li>Studio availability and pricing</li>
          <li>Storage availability and pricing</li>
          <li>Member application workflow</li>
          <li>Payment and renewal system</li>
        </ul>
      </article>
    </div>
  </section>
</BaseLayout>
