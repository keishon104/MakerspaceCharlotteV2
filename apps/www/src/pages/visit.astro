---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Visit MakerSpace Charlotte">
  <section class="page-hero">
    <div class="section-inner">
      <p class="eyebrow">Visit</p>
      <h1>See the space before you join.</h1>
      <p>
        Open house tours run every Wednesday at 7pm. Come see the shops, ask project
        questions, and learn how membership works.
      </p>
      <p>
        <a
          class="button button-primary"
          href="https://www.eventbrite.com/e/makerspace-charlotte-open-house-tickets-1128405373849?aff=ebdsoporgprofile"
        >
          Reserve a Tour
        </a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="section-inner data-grid">
      <article class="data-panel">
        <h2>Open House</h2>
        <ul class="check-list">
          <li>Wednesdays at 7pm</li>
          <li>1003 Louise Ave, Charlotte, NC 28205</li>
          <li>Tour the shops and meet volunteers</li>
          <li>Bring project ideas or questions</li>
        </ul>
      </article>
      <article class="data-panel">
        <h2>What to Expect</h2>
        <p>
          A first visit should answer whether the space, tools, classes, and community
          are a fit for what you want to make. Some tools require training before use.
        </p>
      </article>
    </div>
  </section>

  <section class="section section-alt">
    <div class="section-inner">
      <div class="section-header">
        <div>
          <p class="eyebrow">Tour Flow</p>
          <h2>From curiosity to next step.</h2>
        </div>
      </div>
      <div class="steps">
        <article class="step">
          <h3>Arrive for open house</h3>
          <p>Check in, meet the tour lead, and get oriented to the building.</p>
        </article>
        <article class="step">
          <h3>Walk the shops</h3>
          <p>See what tools are available and where safety training is required.</p>
        </article>
        <article class="step">
          <h3>Choose a path</h3>
          <p>Apply for membership, register for a class, or ask a follow-up question.</p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
