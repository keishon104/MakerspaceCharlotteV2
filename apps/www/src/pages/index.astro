---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ToolpathScene from "../components/ToolpathScene.astro";
import ShopCard from "../components/ShopCard.astro";
import ClassCard from "../components/ClassCard.astro";

const shops = (await getCollection("shops"))
  .filter((shop) => shop.data.featured)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
const classes = (await getCollection("classes"))
  .filter((item) => item.data.featured)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
const equipmentCount = (await getCollection("equipment")).length;
const shopCount = (await getCollection("shops")).length;

const tourUrl =
  "https://www.eventbrite.com/e/makerspace-charlotte-open-house-tickets-1128405373849?aff=ebdsoporgprofile";
const shopSignals = [
  "Woodworking",
  "Digital fabrication",
  "Metal and welding",
  "Pottery",
  "Textiles",
  "Photography",
  "Bike repair",
  "Electronics",
  "T-shirt printing",
  "Leather crafting",
];
---

<BaseLayout
  title="MakerSpace Charlotte | Make Something Real"
  description="Explore 47,000 square feet of shared shops, tools, classes, and creative community at MakerSpace Charlotte."
  immersive
>
  <section class="hero hero-home" data-home-hero>
    <img
      class="hero-background"
      src="/images/generated/makerspace-hero.jpg"
      alt=""
      width="1774"
      height="887"
      fetchpriority="high"
    />
    <div class="hero-overlay"></div>
    <ToolpathScene />

    <div class="hero-content">
      <div class="hero-copy">
        <p class="hero-kicker" data-hero-copy>
          Charlotte, NC / 47,000 sq ft / Open 24/7 for members
        </p>
        <h1 aria-label="MakerSpace Charlotte">
          <span class="hero-line"><span data-hero-line>MakerSpace</span></span>
          <span class="hero-line hero-line-accent"><span data-hero-line>Charlotte</span></span>
        </h1>
        <p class="hero-lede" data-hero-copy>
          Make something that did not exist yesterday. Learn the tools, meet
          your people, and turn the idea in your head into something you can hold.
        </p>
        <div class="hero-actions" data-hero-actions>
          <a class="button button-primary" href={tourUrl}>Book a Wednesday tour</a>
          <a class="button button-ghost" href="/shops/">Explore the shops</a>
        </div>
      </div>

      <div class="hero-meta" data-hero-meta>
        <div>
          <span class="hero-meta-label">Next open house</span>
          <strong>Wednesday / 7:00 PM</strong>
        </div>
        <a href="/equipment/">Search {equipmentCount} tools</a>
      </div>
    </div>

    <a class="scroll-cue" href="#shops" aria-label="Scroll to explore the shops">
      <span>Scroll to explore</span>
      <i></i>
    </a>
  </section>

  <div class="signal-strip" aria-label="MakerSpace Charlotte quick facts">
    <div class="signal-track">
      <div class="signal-group">
        {shopSignals.map((shop) => <span>{shop}</span>)}
      </div>
      <div class="signal-group" aria-hidden="true">
        {shopSignals.map((shop) => <span>{shop}</span>)}
      </div>
    </div>
  </div>

  <section class="section home-shops" id="shops">
    <div class="section-inner">
      <div class="editorial-heading" data-reveal>
        <p class="section-index">01 / The floor</p>
        <div>
          <p class="eyebrow">Choose your medium</p>
          <h2>{shopCount} shops.<br />Thousands of possible first attempts.</h2>
        </div>
        <p class="heading-note">
          Come with a plan or come curious. The space is built for furniture,
          prototypes, ceramics, costumes, repairs, art, and the experiments
          that do not have a category yet.
        </p>
      </div>

      <div class="shop-grid">
        {shops.map((shop, index) => <ShopCard shop={shop} index={index} />)}
      </div>

      <div class="section-actions" data-reveal>
        <a class="button button-dark" href="/shops/">See all {shopCount} shops</a>
        <a class="text-link" href="/equipment/">Search the equipment database</a>
      </div>
    </div>
  </section>

  <section class="maker-manifesto">
    <div class="manifesto-media" data-image-parallax>
      <img
        src="/images/generated/metal-welding-shop.jpg"
        alt="Metalworking and welding shop with work tables, protective curtains, and fabrication tools"
        loading="lazy"
      />
    </div>
    <div class="manifesto-shade"></div>
    <div class="manifesto-inner">
      <p class="section-index">02 / Membership</p>
      <div class="manifesto-copy" data-reveal>
        <p class="eyebrow">Your idea deserves more than a sketch</p>
        <h2>Space to fail.<br />Tools to try again.</h2>
        <p>
          Membership unlocks 24/7 access after onboarding, immediate family
          access, discounted classes, and a community that knows how to help
          when the build gets strange.
        </p>
        <div class="manifesto-stats">
          <div>
            <strong>$50</strong>
            <span>Current monthly membership</span>
          </div>
          <div>
            <strong>24/7</strong>
            <span>Member building access</span>
          </div>
          <div>
            <strong class="manifesto-stat-copy">Immediate family included</strong>
            <span>Access under one membership</span>
          </div>
        </div>
        <a class="button button-light" href="/membership/">How membership works</a>
      </div>
    </div>
  </section>

  <section class="section first-project">
    <div class="section-inner">
      <div class="editorial-heading compact" data-reveal>
        <p class="section-index">03 / Your first week</p>
        <div>
          <p class="eyebrow">No gatekeeping</p>
          <h2>From walking in to making sawdust.</h2>
        </div>
      </div>

      <div class="journey-grid">
        <article class="journey-step" data-reveal>
          <span>01</span>
          <div>
            <p class="eyebrow">Wednesday, 7pm</p>
            <h3>See it in motion</h3>
            <p>Tour the building, meet volunteers, and find the shop that fits your idea.</p>
          </div>
        </article>
        <article class="journey-step" data-reveal>
          <span>02</span>
          <div>
            <p class="eyebrow">Learn safely</p>
            <h3>Take the right first class</h3>
            <p>Build confidence through orientation and hands-on training for higher-risk tools.</p>
          </div>
        </article>
        <article class="journey-step" data-reveal>
          <span>03</span>
          <div>
            <p class="eyebrow">Make it real</p>
            <h3>Start before you feel ready</h3>
            <p>Bring your materials, ask for help, and leave with evidence that the idea works.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section home-classes">
    <div class="section-inner">
      <div class="editorial-heading" data-reveal>
        <p class="section-index">04 / Classes</p>
        <div>
          <p class="eyebrow">Learn by doing</p>
          <h2>Your next skill starts with a messy first draft.</h2>
        </div>
        <p class="heading-note">
          Classes are open to the public and are the easiest way to meet the
          community, learn a shop, and make something on your first visit.
        </p>
      </div>
      <div class="class-grid">
        {classes.map((item) => <ClassCard item={item} />)}
      </div>
      <div class="section-actions" data-reveal>
        <a class="button button-dark" href="/classes/">Browse all classes</a>
      </div>
    </div>
  </section>

  <section class="tour-cta">
    <div class="tour-cta-media" data-image-parallax>
      <img
        src="/images/generated/pottery-studio.jpg"
        alt="MakerSpace Charlotte pottery studio with wheels, clay tools, and work tables"
        loading="lazy"
      />
    </div>
    <div class="tour-cta-content" data-reveal>
      <p class="eyebrow">This Wednesday / 7pm</p>
      <h2>The best way to understand the space is to walk through it.</h2>
      <p>1003 Louise Ave, Charlotte, NC 28205</p>
      <a class="button button-primary" href={tourUrl}>Reserve your tour</a>
    </div>
  </section>
</BaseLayout>
