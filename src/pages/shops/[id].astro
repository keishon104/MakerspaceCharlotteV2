---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const shops = await getCollection("shops");
  return shops.map((shop) => ({
    params: { id: shop.id },
    props: { shop },
  }));
}

interface Props {
  shop: CollectionEntry<"shops">;
}

const { shop } = Astro.props;
const { Content } = await render(shop);
const equipment = (await getCollection("equipment"))
  .filter((item) => item.data.shop === shop.data.title)
  .sort((a, b) => a.data.name.localeCompare(b.data.name));

const statusLabels = {
  available: "Available",
  limited: "Limited",
  "training-required": "Training required",
  "ask-on-tour": "Ask on tour",
};
---

<BaseLayout title={`${shop.data.title} | MakerSpace Charlotte`}>
  <section class="page-hero">
    <div class="section-inner detail-hero">
      <div>
        <p class="eyebrow">{shop.data.category}</p>
        <h1>{shop.data.title}</h1>
        <p>{shop.data.summary}</p>
      </div>
      <img src={shop.data.image.src} alt={shop.data.image.alt} />
    </div>
  </section>

  <section class="section">
    <div class="section-inner data-grid">
      <article class="data-panel">
        <h2>Equipment</h2>
        <ul class="plain-list">
          {shop.data.equipment.map((item) => <li>{item}</li>)}
        </ul>
      </article>
      <article class="data-panel">
        <h2>Access</h2>
        <p>{shop.data.access}</p>
        {
          shop.data.training.length > 0 && (
            <>
              <h3>Training</h3>
              <ul class="plain-list">
                {shop.data.training.map((item) => <li>{item}</li>)}
              </ul>
            </>
          )
        }
      </article>
    </div>
  </section>

  <section class="section section-alt">
    <div class="section-inner">
      <div class="data-panel">
        <Content />
        {
          shop.data.relatedClasses.length > 0 && (
            <>
              <h2>Related Classes</h2>
              <ul class="plain-list">
                {shop.data.relatedClasses.map((item) => <li>{item}</li>)}
              </ul>
            </>
          )
        }
      </div>
    </div>
  </section>

  {
    equipment.length > 0 && (
      <section class="section">
        <div class="section-inner">
          <div class="section-header">
            <div>
              <p class="eyebrow">Equipment</p>
              <h2>Equipment in this shop</h2>
              <p>
                These starter records are meant to be confirmed with shop leads before
                they become operationally authoritative.
              </p>
            </div>
            <a class="button button-outline" href={`/equipment/?shop=${encodeURIComponent(shop.data.title)}`}>
              Search Equipment
            </a>
          </div>
          <div class="equipment-grid">
            {equipment.map((item) => (
              <article class="equipment-card">
                <div class="equipment-card-header">
                  <span class={`status-pill status-${item.data.status}`}>
                    {statusLabels[item.data.status]}
                  </span>
                  {item.data.trainingRequired && <span class="status-pill">Training</span>}
                </div>
                <h3>{item.data.name}</h3>
                <p>{item.data.summary}</p>
                <dl class="equipment-meta">
                  <div>
                    <dt>Category</dt>
                    <dd>{item.data.category}</dd>
                  </div>
                  <div>
                    <dt>Quantity</dt>
                    <dd>{item.data.quantity}</dd>
                  </div>
                </dl>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
