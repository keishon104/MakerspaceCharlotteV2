---
import { memberLoginUrl } from "../lib/urls";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <section>
      <img
        class="footer-logo"
        src="/images/makerspace-charlotte-logo-white.png"
        alt="MakerSpace Charlotte. Make. Learn. Share."
        width="800"
        height="148"
        loading="lazy"
      />
      <p>
        Open 24/7 for members at 1003 Louise Ave, Charlotte, NC 28205.
        Public open house tours run Wednesdays at 7pm.
      </p>
    </section>

    <section>
      <h3>Explore</h3>
      <div class="footer-links">
        <a href="/visit/">Visit</a>
        <a href="/membership/">Membership</a>
        <a href="/shops/">Shops & Tools</a>
        <a href="/equipment/">Equipment Search</a>
        <a href="/classes/">Classes</a>
      </div>
    </section>

    <section>
      <h3>Connect</h3>
      <div class="footer-links">
        <a href="/support/">Support</a>
        <a href="/faq/">FAQ</a>
        <a href="/contact/">Contact</a>
        <a href={memberLoginUrl}>Member Login</a>
      </div>
    </section>

    <p class="footer-meta">© {year} MakerSpace Charlotte. Prototype static site.</p>
  </div>
</footer>
