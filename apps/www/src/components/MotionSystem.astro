<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.documentElement.classList.add("motion-ready");

  if (!reducedMotion) {
    const heroLines = document.querySelectorAll("[data-hero-line]");
    if (heroLines.length > 0) {
      const intro = gsap.timeline({ defaults: { ease: "power3.out" } });
      intro
        .from(heroLines, {
          yPercent: 115,
          duration: 1.05,
          stagger: 0.1,
        })
        .from("[data-hero-copy], [data-hero-actions], [data-hero-meta]", {
          y: 24,
          opacity: 0,
          duration: 0.75,
          stagger: 0.08,
        }, "-=0.55");
    }

    gsap.utils.toArray<HTMLElement>("[data-reveal]").forEach((element) => {
      gsap.from(element, {
        scrollTrigger: {
          trigger: element,
          start: "top 88%",
          once: true,
        },
        y: 46,
        opacity: 0,
        duration: 0.9,
        ease: "power3.out",
      });
    });

    gsap.utils.toArray<HTMLElement>("[data-image-parallax]").forEach((element) => {
      const image = element.querySelector("img");
      if (!image) return;

      gsap.fromTo(
        image,
        { yPercent: -5, scale: 1.08 },
        {
          yPercent: 5,
          scale: 1.02,
          ease: "none",
          scrollTrigger: {
            trigger: element,
            start: "top bottom",
            end: "bottom top",
            scrub: 0.7,
          },
        },
      );
    });

    const makerScene = document.querySelector("[data-maker-scene]");
    const homeHero = document.querySelector("[data-home-hero]");
    if (makerScene && homeHero) {
      gsap.to(makerScene, {
        yPercent: 14,
        opacity: 0.38,
        ease: "none",
        scrollTrigger: {
          trigger: homeHero,
          start: "top top",
          end: "bottom top",
          scrub: 0.5,
        },
      });
    }
  }
</script>
