---
import { memberLoginUrl } from "../lib/urls";

const exploreItems = [
  {
    href: "/shops/",
    label: "Shops",
    description: "Explore seven creative work areas",
  },
  {
    href: "/equipment/",
    label: "Equipment",
    description: "Search tools, machines, and access notes",
  },
];

const currentPath = Astro.url.pathname;
const isHome = currentPath === "/";
---

<header class:list={["site-header", { "site-header-home": isHome }]}>
  <div class="header-inner">
    <a class="brand" href="/" aria-label="MakerSpace Charlotte home">
      <img
        src="/images/makerspace-charlotte-logo-white.png"
        alt="MakerSpace Charlotte. Make. Learn. Share."
        width="800"
        height="148"
      />
    </a>

    <nav class="site-nav" aria-label="Primary navigation">
      <details class="nav-disclosure">
        <summary>Explore</summary>
        <div class="nav-panel">
          {exploreItems.map((item) => (
            <a href={item.href}>
              <span>{item.label}</span>
              <small>{item.description}</small>
            </a>
          ))}
        </div>
      </details>
      <a href="/classes/">Classes</a>
      <a href="/membership/">Membership</a>
      <a href="/visit/">Visit</a>
      <a href="/about/">About</a>
    </nav>

    <div class="header-actions">
      <a class="member-link" href={memberLoginUrl}>Member login</a>
      <a
        class="button button-primary header-tour"
        href="https://www.eventbrite.com/e/makerspace-charlotte-open-house-tickets-1128405373849?aff=ebdsoporgprofile"
      >
        Book a Tour
      </a>
    </div>

    <details class="mobile-menu">
      <summary>Menu</summary>
      <nav aria-label="Mobile navigation">
        <a href="/shops/">Shops</a>
        <a href="/equipment/">Equipment</a>
        <a href="/classes/">Classes</a>
        <a href="/membership/">Membership</a>
        <a href="/visit/">Visit</a>
        <a href="/about/">About</a>
        <a href="/support/">Support</a>
        <a href={memberLoginUrl}>Member login</a>
      </nav>
    </details>
  </div>
</header>
