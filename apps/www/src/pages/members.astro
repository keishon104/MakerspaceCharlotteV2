---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Member Portal Concept | MakerSpace Charlotte">
  <section class="page-hero">
    <div class="section-inner">
      <p class="eyebrow">Member Portal</p>
      <h1>Keep account features separate from the static public site.</h1>
      <p>
        This route is a placeholder for the future authenticated member hub. The public
        website can stay static while the portal handles account-specific features.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="section-inner data-grid">
      <article class="data-panel">
        <h2>Phase 1</h2>
        <ul class="check-list">
          <li>Member login and account creation</li>
          <li>Member resource links</li>
          <li>Benefits and discount instructions</li>
          <li>Profile basics</li>
        </ul>
      </article>
      <article class="data-panel">
        <h2>Later</h2>
        <ul class="plain-list">
          <li>Membership status integration</li>
          <li>Shop authorizations</li>
          <li>Training requests</li>
          <li>Studio or storage status</li>
        </ul>
      </article>
    </div>
  </section>
</BaseLayout>
