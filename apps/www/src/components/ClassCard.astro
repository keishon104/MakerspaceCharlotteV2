---
import type { CollectionEntry } from "astro:content";

interface Props {
  item: CollectionEntry<"classes">;
}

const { item } = Astro.props;
---

<article class="card">
  <div class="card-media class-card-media">
    <img src={item.data.image.src} alt={item.data.image.alt} loading="lazy" />
  </div>
  <div class="card-body">
    <span class="tag">{item.data.category}</span>
    <h3>{item.data.title}</h3>
    <p>{item.data.summary}</p>
    <ul class="plain-list">
      <li>{item.data.level}</li>
      <li>{item.data.schedule}</li>
      <li>{item.data.pricing}</li>
    </ul>
    <p>
      <a class="button button-outline" href={`/classes/${item.id}/`}>Browse Dates</a>
    </p>
  </div>
</article>
