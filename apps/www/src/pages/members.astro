---
import BaseLayout from "../layouts/BaseLayout.astro";
import { memberLoginUrl } from "../lib/urls";
---

<BaseLayout title="Member Login | MakerSpace Charlotte">
  <section class="page-hero">
    <div class="section-inner">
      <p class="eyebrow">Member Login</p>
      <h1>Opening the MakerSpace Charlotte member app.</h1>
      <p>
        Member accounts, benefits, Discord guidance, shop instructions, and admin
        workflows live in the separate member app.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href={memberLoginUrl}>Continue to Member App</a>
        <a class="button button-secondary" href="/">Return to Public Site</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-inner data-grid">
      <article class="data-panel">
        <h2>Current MVP</h2>
        <ul class="check-list">
          <li>Member login and account creation</li>
          <li>Member resource links and Discord guide</li>
          <li>Benefits and discount instructions</li>
          <li>Profile, household, and admin review basics</li>
        </ul>
      </article>
      <article class="data-panel">
        <h2>Separate App URL</h2>
        <ul class="plain-list">
          <li>{memberLoginUrl}</li>
        </ul>
      </article>
    </div>
  </section>
  <script is:inline define:vars={{ memberLoginUrl }}>
    window.setTimeout(() => {
      window.location.href = memberLoginUrl;
    }, 800);
  </script>
</BaseLayout>
