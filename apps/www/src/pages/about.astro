---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About | MakerSpace Charlotte">
  <section class="page-hero">
    <div class="section-inner">
      <p class="eyebrow">About</p>
      <h1>A nonprofit community workshop for makers of all ages.</h1>
      <p>
        MakerSpace Charlotte encourages technological creativity and community by
        enabling people to use tools, learn by making things, and share knowledge.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="section-inner split">
      <div>
        <h2>Make the mission concrete.</h2>
        <p>
          The about page should build trust without burying practical information.
          It can explain the nonprofit model, the move to Louise Ave, and the
          volunteer-run culture.
        </p>
        <ul class="check-list">
          <li>Mission and nonprofit status</li>
          <li>Volunteer-led community model</li>
          <li>Press and media mentions</li>
          <li>Board or leadership info if publishable</li>
        </ul>
      </div>
      <div class="split-media">
        <img
          src="https://cdn.prod.website-files.com/64062b4928d43ee6320fe42d/6408c91395246dd913d09687_mother-with-son-pottery-class-p-1080.jpg"
          alt="A pottery class at MakerSpace Charlotte"
          loading="lazy"
        />
      </div>
    </div>
  </section>
</BaseLayout>
