---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact | MakerSpace Charlotte">
  <section class="page-hero">
    <div class="section-inner">
      <p class="eyebrow">Contact</p>
      <h1>Route questions to the right next step.</h1>
      <p>
        For most new visitors, the answer is still the Wednesday open house. Contact
        should handle exceptions, group questions, donations, sponsorships, and account help.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="section-inner data-grid">
      <article class="data-panel">
        <h2>Best First Step</h2>
        <p>Attend the Wednesday 7pm open house at 1003 Louise Ave.</p>
        <p>
          <a
            class="button button-primary"
            href="https://www.eventbrite.com/e/makerspace-charlotte-open-house-tickets-1128405373849?aff=ebdsoporgprofile"
          >
            Book a Tour
          </a>
        </p>
      </article>
      <article class="data-panel">
        <h2>Contact Form Placeholder</h2>
        <p>
          For launch, this can use Netlify Forms, Tally, Formspree, or an existing
          makerspace inbox. The IA should define who receives each submission type.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
