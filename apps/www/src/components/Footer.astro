---
import { memberLoginUrl } from "../lib/urls";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <section class="footer-intro">
      <p class="eyebrow">Make. Learn. Share.</p>
      <h2>Ideas need somewhere to get loud.</h2>
      <img
        class="footer-logo"
        src="/images/makerspace-charlotte-logo-white.png"
        alt="MakerSpace Charlotte. Make. Learn. Share."
        width="800"
        height="148"
        loading="lazy"
      />
      <p>
        Charlotte's nonprofit community workshop. Open 24/7 for members at
        1003 Louise Ave.
      </p>
      <a
        class="button button-primary"
        href="https://www.eventbrite.com/e/makerspace-charlotte-open-house-tickets-1128405373849?aff=ebdsoporgprofile"
      >
        Visit Wednesday at 7pm
      </a>
    </section>

    <section class="footer-nav">
      <h3>Explore</h3>
      <div class="footer-links">
        <a href="/visit/">Visit</a>
        <a href="/membership/">Membership</a>
        <a href="/shops/">Shops & Tools</a>
        <a href="/equipment/">Equipment Search</a>
        <a href="/classes/">Classes</a>
      </div>
    </section>

    <section class="footer-nav">
      <h3>Connect</h3>
      <div class="footer-links">
        <a href="/support/">Support</a>
        <a href="/faq/">FAQ</a>
        <a href="/contact/">Contact</a>
        <a href={memberLoginUrl}>Member Login</a>
      </div>
    </section>

    <div class="footer-meta">
      <p>© {year} MakerSpace Charlotte</p>
      <p>Make something that did not exist yesterday.</p>
    </div>
  </div>
</footer>
